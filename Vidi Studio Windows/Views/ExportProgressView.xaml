<UserControl x:Class="Vidi_Studio_Windows.Views.ExportProgressView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ItemsControl x:Name="Sessions" ItemsSource="{x:Bind Active}">
  <ItemsControl.ItemTemplate><DataTemplate>
   <Grid Padding="14,8" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="3"><TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <ProgressBar Grid.Column="1" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" VerticalAlignment="Center" AutomationProperties.Name="Export progress"/>
    <Button Grid.Column="2" Content="Cancel export" IsEnabled="{Binding CanCancel}" Tag="{Binding}" Click="CancelExport_Click" VerticalAlignment="Center"/>
   </Grid>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
