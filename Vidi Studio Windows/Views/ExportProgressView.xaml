<UserControl x:Class="Vidi_Studio_Windows.Views.ExportProgressView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ItemsControl x:Name="Sessions" ItemsSource="{x:Bind Active}">
  <ItemsControl.ItemTemplate><DataTemplate>
   <StackPanel Padding="0,8" Spacing="12">
    <TextBlock Text="{Binding ProjectName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap" FontSize="15" AutomationProperties.LiveSetting="Polite"/>
    <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" AutomationProperties.Name="Export progress"/>
    <Button Content="Cancel export" IsEnabled="{Binding CanCancel}" Tag="{Binding}" Click="CancelExport_Click" HorizontalAlignment="Right"/>
   </StackPanel>
  </DataTemplate></ItemsControl.ItemTemplate>
 </ItemsControl>
</UserControl>
