<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Vidi_Studio_Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Version>1.0.169</Version>
    <Product>Vidi Studio</Product>
    <AssemblyTitle>Vidi Studio</AssemblyTitle>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The package logo variants must also be present in the loose debug
         layout (AppxManifest.xml next to the executable), otherwise the
         taskbar and Start tile fall back to the generic app icon even though
         the window and executable carry AppIcon.ico. -->
    <Content Include="Assets\AppIcon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SplashScreen.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Square44x44Logo.targetsize-*.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\StoreLogo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Help\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <!--
    The Windows 11 modern context menu is implemented by a native COM surrogate
    server. It is an optional enhancement: build it only when the Visual C++
    desktop toolset for the selected architecture is installed, so a machine
    with only the WinUI/.NET workloads still builds and runs the app with the
    legacy registry context menu. Visual Studio and MSBuild set VCTargetsPath;
    the VSInstallRoot/MSBuildExtensionsPath32 checks cover hosts that do not.
  -->
  <PropertyGroup>
    <VidiShellToolsetRoot Condition="'$(VidiShellToolsetRoot)' == '' and '$(VCTargetsPath)' != ''">$(VCTargetsPath)</VidiShellToolsetRoot>
    <VidiShellToolsetRoot Condition="'$(VidiShellToolsetRoot)' == '' and Exists('$(VSInstallRoot)\MSBuild\Microsoft\VC\v180\Microsoft.Cpp.Default.props')">$(VSInstallRoot)\MSBuild\Microsoft\VC\v180\</VidiShellToolsetRoot>
    <VidiShellToolsetRoot Condition="'$(VidiShellToolsetRoot)' == '' and Exists('$(VSInstallRoot)\MSBuild\Microsoft\VC\v170\Microsoft.Cpp.Default.props')">$(VSInstallRoot)\MSBuild\Microsoft\VC\v170\</VidiShellToolsetRoot>
    <VidiShellToolsetRoot Condition="'$(VidiShellToolsetRoot)' == '' and Exists('$(MSBuildExtensionsPath32)\Microsoft\VC\v180\Microsoft.Cpp.Default.props')">$(MSBuildExtensionsPath32)\Microsoft\VC\v180\</VidiShellToolsetRoot>
    <VidiShellToolsetRoot Condition="'$(VidiShellToolsetRoot)' == '' and Exists('$(MSBuildExtensionsPath32)\Microsoft\VC\v170\Microsoft.Cpp.Default.props')">$(MSBuildExtensionsPath32)\Microsoft\VC\v170\</VidiShellToolsetRoot>
    <VidiShellToolsetRoot Condition="'$(VidiShellToolsetRoot)' != '' and !HasTrailingSlash('$(VidiShellToolsetRoot)')">$(VidiShellToolsetRoot)\</VidiShellToolsetRoot>
    <VidiShellExtensionBuild Condition="'$(VidiShellExtensionBuild)' == '' and Exists('$(VidiShellToolsetRoot)\Platforms\$(Platform)\PlatformToolsets\v145')">true</VidiShellExtensionBuild>
    <VidiShellExtensionBuild Condition="'$(VidiShellExtensionBuild)' == '' and Exists('$(VidiShellToolsetRoot)\Platforms\$(Platform)\PlatformToolsets\v144')">true</VidiShellExtensionBuild>
    <VidiShellExtensionBuild Condition="'$(VidiShellExtensionBuild)' == '' and Exists('$(VidiShellToolsetRoot)\Platforms\$(Platform)\PlatformToolsets\v143')">true</VidiShellExtensionBuild>
    <VidiShellExtensionBuild Condition="'$(VidiShellExtensionBuild)' == '' and Exists('$(VidiShellToolsetRoot)\Platforms\$(Platform)\PlatformToolsets\v142')">true</VidiShellExtensionBuild>
    <VidiShellExtensionBuild Condition="'$(VidiShellExtensionBuild)' == ''">false</VidiShellExtensionBuild>
  </PropertyGroup>
  <PropertyGroup>
    <VidiShellExtensionProject>$(MSBuildThisFileDirectory)..\ShellExtension\VidiStudio.ShellExtension.vcxproj</VidiShellExtensionProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(VidiShellExtensionBuild)' == 'true'">
    <!-- The target below builds this DLL before the content is copied so it is
         present for the loose debug layout and MSIX packaging. A ProjectReference
         is avoided because the solution marks the native project as not building
         (so machines without C++ still build); a plain reference would therefore
         be skipped by solution builds. -->
    <Content Include="..\runtime\shell\$(Platform)\VidiStudio.ShellExtension.dll" Link="VidiStudio.ShellExtension.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Build the native extension directly with the selected configuration and
       platform. RemoveProperties keeps the solution's project configuration map
       from falling back to Win32 for the project that is excluded from solution
       builds. -->
  <Target Name="BuildOptionalShellExtension"
          BeforeTargets="PrepareForBuild"
          Condition="'$(VidiShellExtensionBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="$(VidiShellExtensionProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(Platform);VCTargetsPath=$(VidiShellToolsetRoot)"
             RemoveProperties="BuildingSolutionFile;CurrentSolutionConfigurationContents;SolutionDir;SolutionName;SolutionExt;SolutionPath" />
  </Target>
  <Target Name="NoteOptionalShellExtension" BeforeTargets="PrepareForBuild"
          Condition="'$(VidiShellExtensionBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="The Visual C++ toolset for $(Platform) is not installed; building without the optional native Windows 11 context-menu extension. Install the Desktop development with C++ workload (including the $(Platform) build tools) and rebuild to include it." />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug'">False</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <!-- Always refresh the engine sources: an updated app must never run a stale engine
         (PreserveNewest skipped the copy when the source timestamp was older, which left the
         Gemini key handoff and other engine changes out of the running app). -->
    <Content Include="..\engine\*.py;..\engine\ai-defaults.json;..\engine\requirements.txt" Link="engine\%(Filename)%(Extension)" CopyToOutputDirectory="Always" />
    <Content Include="Assets\youtube.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\piper-voices.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\piper-notice.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\runtime\speech\$(Platform)\**\*" Link="speech\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\runtime\engine\**\*" Link="engine-bin\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\runtime\piper\**\*" Link="piper\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The bundled speech helper is published into runtime\speech by setup-windows.ps1. Republish it
       whenever its sources change, so a Visual Studio build never packages a stale helper. -->
  <PropertyGroup>
    <SpeechHostPublishDir>$(MSBuildThisFileDirectory)..\runtime\speech\$(Platform)</SpeechHostPublishDir>
    <SpeechHostProject>$(MSBuildThisFileDirectory)..\SpeechHost\SpeechHost.csproj</SpeechHostProject>
  </PropertyGroup>
  <ItemGroup>
    <SpeechHostSource Include="..\SpeechHost\**\*.cs;..\SpeechHost\SpeechHost.csproj" Exclude="..\SpeechHost\bin\**;..\SpeechHost\obj\**" />
    <UpToDateCheckInput Include="@(SpeechHostSource)" />
  </ItemGroup>
  <Target Name="PublishSpeechHost" BeforeTargets="PrepareForBuild" Condition="('$(Platform)' == 'ARM64' or '$(Platform)' == 'x64') and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(SpeechHostSource)" Outputs="$(SpeechHostPublishDir)\VidiStudio.SpeechHost.exe">
    <PropertyGroup>
      <SpeechHostWasMissing Condition="!Exists('$(SpeechHostPublishDir)\VidiStudio.SpeechHost.exe')">true</SpeechHostWasMissing>
      <SpeechHostRid>win-$(Platform.ToLowerInvariant())</SpeechHostRid>
      <!-- Prefer the .NET SDK in Program Files; the dotnet on PATH may be a different bitness. -->
      <SpeechHostDotnet Condition="'$(SpeechHostDotnet)' == '' and Exists('$(ProgramFiles)\dotnet\dotnet.exe')">$(ProgramFiles)\dotnet\dotnet.exe</SpeechHostDotnet>
      <SpeechHostDotnet Condition="'$(SpeechHostDotnet)' == ''">dotnet</SpeechHostDotnet>
    </PropertyGroup>
    <Message Importance="high" Text="Publishing the $(Platform) speech helper because its sources changed." />
    <!-- Published with a separate dotnet process, exactly like script\setup-windows.ps1, so this
         build never nests one MSBuild project inside another. A failure only warns: the existing
         helper keeps working and the app must still build and run. -->
    <Exec Command="&quot;$(SpeechHostDotnet)&quot; publish &quot;$(SpeechHostProject)&quot; -c Release -r $(SpeechHostRid) --self-contained true -p:Platform=$(Platform) -o &quot;$(SpeechHostPublishDir)&quot;"
          ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="SpeechHostExitCode" />
    </Exec>
    <Warning Condition="'$(SpeechHostExitCode)' != '0'"
             Text="The $(Platform) speech helper could not be rebuilt (exit code $(SpeechHostExitCode)); the copy in runtime\speech\$(Platform) is used. Run script\setup-windows.ps1, then build again." />
    <!-- On the very first build the folder was empty when items were evaluated, so add the files now. -->
    <ItemGroup Condition="'$(SpeechHostWasMissing)' == 'true'">
      <Content Include="$(SpeechHostPublishDir)\**\*" Link="speech\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- Piper ships with the app so people never install a separate speech engine. The runtime is
       fetched once into runtime\piper (and verified by SHA-256) before it is packaged. -->
  <PropertyGroup>
    <PiperRuntimeDir>$(MSBuildThisFileDirectory)..\runtime\piper</PiperRuntimeDir>
    <PiperFetchScript>$(MSBuildThisFileDirectory)..\script\fetch-piper.ps1</PiperFetchScript>
  </PropertyGroup>
  <Target Name="FetchPiperRuntime" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <PiperWasMissing Condition="!Exists('$(PiperRuntimeDir)\piper.exe')">true</PiperWasMissing>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(PiperFetchScript)&quot;"
          Condition="'$(PiperWasMissing)' == 'true'" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="PiperFetchExitCode" />
    </Exec>
    <Warning Condition="'$(PiperFetchExitCode)' != '0' and '$(PiperFetchExitCode)' != ''"
             Text="The bundled Piper speech engine could not be downloaded (exit code $(PiperFetchExitCode)). Piper voices will be unavailable until script\fetch-piper.ps1 succeeds and the app is built again." />
    <!-- On the first build the folder was empty when items were evaluated, so add the files now. -->
    <ItemGroup Condition="'$(PiperWasMissing)' == 'true' and Exists('$(PiperRuntimeDir)\piper.exe')">
      <Content Include="$(PiperRuntimeDir)\**\*" Link="piper\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>

