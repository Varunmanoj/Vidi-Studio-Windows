<UserControl x:Class="Vidi_Studio_Windows.Views.ProgressOverlay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="using:Vidi_Studio_Windows.Views" Visibility="Collapsed">
 <Grid>
  <Border x:Name="ProgressCard" MaxWidth="560" Margin="24" Padding="24"
   HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="12"
   Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
   <Border.Shadow><ThemeShadow/></Border.Shadow>
   <ScrollViewer x:Name="ProgressScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="18">
     <TextBlock x:Name="Heading" Text="Processing" FontSize="20" FontWeight="SemiBold"/>
     <StackPanel x:Name="ProcessingPanel" Spacing="16">
      <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ProgressRing x:Name="ProcessingRing" Width="36" Height="36" IsActive="False"/>
       <TextBlock x:Name="ProcessingStatus" Grid.Column="1" TextWrapping="Wrap" FontSize="15" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
      </Grid>
      <Button Content="Cancel processing" Click="CancelProcessing_Click" HorizontalAlignment="Right"/>
     </StackPanel>
     <views:ExportProgressView x:Name="Exports"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
