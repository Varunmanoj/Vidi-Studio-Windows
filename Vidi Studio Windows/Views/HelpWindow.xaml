<Window
    x:Class="Vidi_Studio_Windows.Views.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Vidi Studio Help">
    <Grid x:Name="Root" Loaded="Root_Loaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,6" HorizontalAlignment="Right">
            <ProgressRing x:Name="LoadingRing" Width="20" Height="20" IsActive="True"
                          AutomationProperties.Name="Loading documentation"/>
            <Button x:Name="BrowserButton" Content="Open in Browser" Click="OpenGuideInBrowser">
                <Button.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Open in Browser" Click="OpenGuideInBrowser"/>
                    </MenuFlyout>
                </Button.ContextFlyout>
            </Button>
        </StackPanel>
        <WebView2 Grid.Row="1" x:Name="ContentView" AutomationProperties.Name="VidiStudio documentation"/>
        <TextBlock Grid.Row="1" x:Name="StatusMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
</Window>
