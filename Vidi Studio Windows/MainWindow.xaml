<Window x:Class="Vidi_Studio_Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Vidi_Studio_Windows.Views" Title="Vidi Studio">
 <Grid x:Name="Root" Background="Transparent">
  <Grid.Resources>
   <views:BooleanVisibilityConverter x:Key="VisibleWhenTrue"/>
   <Style x:Key="CompactButton" TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="30"/></Style>
   <Style x:Key="InspectorButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,7"/></Style>
   <DataTemplate x:Key="ProjectCard">
    <StackPanel Width="236" Spacing="9" Padding="4">
     <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Height="132"><Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" AutomationProperties.Name="Project thumbnail"/></Border>
     <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
     <TextBlock Text="{Binding ProjectSubtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
     <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding IntegrityIsDamaged, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{Binding IntegrityStatus}">
      <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#E52B32"/>
      <TextBlock Text="{Binding IntegrityStatus}" Foreground="#E52B32" FontSize="11" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{Binding IntegrityHasWarning, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{Binding IntegrityStatus}">
      <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#C77A00"/>
      <TextBlock Text="{Binding IntegrityStatus}" Foreground="#C77A00" FontSize="11" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="20" Margin="2,2,0,5">
      <SymbolIcon Symbol="Comment" Opacity="{Binding TranscriptOpacity}" ToolTipService.ToolTip="{Binding TranscriptStatus}" AutomationProperties.Name="{Binding TranscriptStatus}"/>
      <SymbolIcon Symbol="AlignLeft" Opacity="{Binding SummaryOpacity}" ToolTipService.ToolTip="{Binding SummaryStatus}" AutomationProperties.Name="{Binding SummaryStatus}"/>
      <SymbolIcon Symbol="Volume" Opacity="{Binding NarrationOpacity}" ToolTipService.ToolTip="{Binding NarrationStatus}" AutomationProperties.Name="{Binding NarrationStatus}"/>
      <SymbolIcon Symbol="Video" Opacity="{Binding ExportsOpacity}" ToolTipService.ToolTip="{Binding ExportsStatus}" AutomationProperties.Name="{Binding ExportsStatus}"/>
     </StackPanel>
    </StackPanel>
   </DataTemplate>
   <DataTemplate x:Key="EditorProjectCard">
    <StackPanel Width="180" Spacing="6" Padding="4">
     <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Height="100"><Image Source="{Binding ThumbnailUri}" Stretch="UniformToFill" AutomationProperties.Name="Project thumbnail"/></Border>
     <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/>
     <TextBlock Text="{Binding ProjectSubtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
   </DataTemplate>
   <DataTemplate x:Key="SegmentRow">
    <Grid>
     <Border Background="#550078D4" CornerRadius="6" Visibility="{Binding IsActive, Converter={StaticResource VisibleWhenTrue}}" IsHitTestVisible="False"/>
    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="8,16,8,16">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
      <Button Content="&#xE768;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Top" Tag="{Binding}" Click="SegmentPlay_Click" AutomationProperties.Name="{Binding PlayLabel}" ToolTipService.ToolTip="{Binding PlayLabel}"/>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding StartLabel}"/><TextBlock Text="{Binding EndLabel}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      <StackPanel Grid.Column="2" Spacing="8">
       <TextBlock Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Visibility="{Binding ShowKind, Converter={StaticResource VisibleWhenTrue}}"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding ShowOrigin, Converter={StaticResource VisibleWhenTrue}}" ToolTipService.ToolTip="{Binding OriginLabel}" AutomationProperties.Name="{Binding OriginLabel}"><FontIcon Glyph="{Binding OriginGlyph}" FontSize="12"><FontIcon.Foreground><SolidColorBrush Color="{Binding OriginColor}"/></FontIcon.Foreground></FontIcon><TextBlock Text="{Binding OriginLabel}" FontWeight="SemiBold"><TextBlock.Foreground><SolidColorBrush Color="{Binding OriginColor}"/></TextBlock.Foreground></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="{Binding DurationLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono" AutomationProperties.Name="{Binding DurationLabel}" ToolTipService.ToolTip="Segment duration"/></Grid>
       <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsTimingFlagged, Converter={StaticResource VisibleWhenTrue}}" ToolTipService.ToolTip="{Binding TimingFlagHelp}" AutomationProperties.Name="Description timing overlaps. Needs retiming."><FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#D87919"/><TextBlock Text="Overlap" FontWeight="SemiBold" Foreground="#D87919"/></StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsDescription, Converter={StaticResource VisibleWhenTrue}}"><ProgressRing Width="14" Height="14" IsActive="{Binding IsNarrating}" Visibility="{Binding ShowAudioSpinner, Converter={StaticResource VisibleWhenTrue}}" VerticalAlignment="Center" AutomationProperties.Name="Generating narration audio"/><FontIcon Glyph="{Binding AudioStatusGlyph}" FontSize="12" VerticalAlignment="Center"><FontIcon.Foreground><SolidColorBrush Color="{Binding AudioStatusColor}"/></FontIcon.Foreground></FontIcon><TextBlock Text="{Binding AudioStatus}" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Foreground><SolidColorBrush Color="{Binding AudioStatusColor}"/></TextBlock.Foreground></TextBlock></StackPanel>
       <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="16"/>
      </StackPanel>
      <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Top"><ProgressRing Width="18" Height="18" IsActive="{Binding IsNarrating}" Visibility="{Binding ShowAudioSpinner, Converter={StaticResource VisibleWhenTrue}}" HorizontalAlignment="Center" AutomationProperties.Name="Generating segment audio"/><Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Tag="{Binding}" Click="SegmentEditRow_Click" Padding="7" Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="Edit segment" ToolTipService.ToolTip="Edit segment"/><Button Content="{Binding PreviewGlyph}" FontFamily="Segoe Fluent Icons" Tag="{Binding}" Click="SegmentPreview_Click" Padding="7" Visibility="{Binding IsDescription, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{Binding PreviewLabel}" ToolTipService.ToolTip="{Binding PreviewLabel}" IsEnabled="{Binding AudioReady}"/>
       <Button Content="&#xE712;" FontFamily="Segoe Fluent Icons" Tag="{Binding}" Click="SegmentMore_Click" Padding="7" Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="More segment options" ToolTipService.ToolTip="More segment options"/>
      </StackPanel>
     </Grid>
    </Border>
    </Grid>
   </DataTemplate>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="AppTitleBar" Background="Transparent" AutomationProperties.Name="Vidi Studio title bar">
   <StackPanel Orientation="Horizontal" Spacing="8" Padding="16,0" VerticalAlignment="Center" IsHitTestVisible="False">
    <Image Source="ms-appx:///Assets/Square44x44Logo.scale-200.png" Width="16" Height="16" Stretch="Uniform"/>
    <TextBlock Text="Vidi Studio" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
  </Grid>
  <MenuBar x:Name="MainMenu" Grid.Row="1" Background="Transparent"/>
  <Border x:Name="AppSurface" Grid.Row="2" Grid.RowSpan="4" Background="{ThemeResource LayerFillColorDefaultBrush}" IsHitTestVisible="False"/>
  <StackPanel Grid.Row="2">
   <InfoBar x:Name="ApiKeyWarningBar" Severity="Warning" IsOpen="False" IsClosable="False" Margin="16,8,16,0"
            Title="Gemini API Key Required"
            Message="Application features are disabled until a personal Gemini API key is configured. Please enter your API key in Settings (Gemini API tab) to enable project creation, transcription, video analysis, summaries, descriptions, narration, and exports.">
    <InfoBar.ActionButton>
     <Button Content="Enter API Key" Style="{StaticResource AccentButtonStyle}" Click="OpenGeminiSettings_Click"/>
    </InfoBar.ActionButton>
   </InfoBar>
   <InfoBar x:Name="AiWarningBar" Severity="Warning" IsOpen="False" IsClosable="False" Margin="16,8,16,0"
            Title="Gemini AI Processing Paused"
            Message="AI reprocessing is disabled after a Gemini quota, billing, or service error. Existing work is unchanged.">
    <InfoBar.ActionButton>
     <Button Content="Retry AI" Click="AiRetry_Click"/>
    </InfoBar.ActionButton>
   </InfoBar>
   <InfoBar x:Name="ProjectIntegrityBar" Severity="Warning" IsOpen="False" IsClosable="False" Margin="16,8,16,8"
            Title="Project Files Missing"
            Message="Some files that belong to this project are missing.">
    <InfoBar.ActionButton>
     <Button x:Name="ProjectIntegrityPrimaryAction" Click="ProjectIntegrityPrimaryAction_Click"/>
    </InfoBar.ActionButton>
    <InfoBar.Content>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ProjectIntegrityRegenerateButton" Click="ProjectIntegrityRegenerate_Click" Visibility="Collapsed"/>
      <Button x:Name="ProjectIntegrityDetailsButton" Content="Review issues…" Click="ProjectIntegrityDetails_Click" Visibility="Collapsed"/>
      <Button x:Name="ProjectIntegrityFinderButton" Content="Show in Explorer" Click="Reveal_Click" Visibility="Collapsed"/>
     </StackPanel>
    </InfoBar.Content>
   </InfoBar>
  </StackPanel>
  <Grid Grid.Row="3" Padding="20,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" MinHeight="54">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Center" ColumnSpacing="8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ProjectTitle" Text="All Projects" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    <Button x:Name="RenameProjectTitleButton" Grid.Column="1" Content="&#xE70F;" FontFamily="Segoe Fluent Icons" Click="RenameProjectTitle_Click" Visibility="Collapsed" ToolTipService.ToolTip="Rename this project" AutomationProperties.Name="Rename project" AutomationProperties.AutomationId="rename-project-title"/>
   </Grid>
   <Grid x:Name="GallerySearchHost" Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="520" Margin="8,0">
    <TextBox x:Name="GallerySearch" PlaceholderText="Search projects" TextChanged="GallerySearch_Changed" AutomationProperties.Name="Search all projects" Padding="36,5,12,5" CornerRadius="18"/>
    <SymbolIcon Symbol="Find" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
   </Grid>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
    <Button x:Name="GalleryImport" Content="New project" Style="{StaticResource AccentButtonStyle}" Click="NewProject_Click"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="GalleryPanel" Grid.Row="4" Padding="28,24" RowSpacing="22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="4"><TextBlock Text="All Projects" Style="{ThemeResource TitleLargeTextBlockStyle}"/><TextBlock x:Name="ProjectCount" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <ComboBox x:Name="GalleryFilter" SelectedIndex="0" SelectionChanged="GalleryFilter_Changed" AutomationProperties.Name="Project source"><ComboBoxItem Content="All projects"/><ComboBoxItem Content="Local video"/><ComboBoxItem Content="YouTube"/></ComboBox>
     <Button Content="&#xE8FD;" FontFamily="Segoe Fluent Icons" Click="GalleryLayout_Click" AutomationProperties.Name="Switch list and grid view"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1">
    <GridView x:Name="GalleryGrid" ItemsSource="{x:Bind Model.Projects}" ItemTemplate="{StaticResource ProjectCard}" IsItemClickEnabled="True" ItemClick="GalleryProject_Click" ContextRequested="ProjectContext_Requested" SelectionMode="Single" AutomationProperties.Name="All projects grid"/>
    <Grid x:Name="GalleryTable" Visibility="Collapsed" RowSpacing="4">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
       <TextBlock Text="Name"/><TextBlock Grid.Column="1" Text="Duration"/><TextBlock Grid.Column="2" Text="AD Segments"/><TextBlock Grid.Column="3" Text="Transcript"/><TextBlock Grid.Column="4" Text="Summary"/><TextBlock Grid.Column="5" Text="AD"/><TextBlock Grid.Column="6" Text="Video Export"/><TextBlock Grid.Column="7" Text="Audio Export"/>
      </Grid>
     </Border>
     <ListView x:Name="GalleryList" Grid.Row="1" ItemsSource="{x:Bind Model.Projects}" IsItemClickEnabled="True" ItemClick="GalleryProject_Click" ContextRequested="ProjectContext_Requested" AutomationProperties.Name="All projects table">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="46"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate><DataTemplate>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Margin="0,2">
        <Grid ColumnSpacing="8" Padding="12,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="2.5*"/><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="0.7*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
         <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Video"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding IntegrityStatus}" Foreground="#E52B32" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IntegrityIsDamaged, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{Binding IntegrityStatus}"/><TextBlock Grid.Column="2" Text="{Binding IntegrityStatus}" Foreground="#C77A00" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="{Binding IntegrityHasWarning, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.Name="{Binding IntegrityStatus}"/></Grid>
         <TextBlock Grid.Column="1" Text="{Binding DurationLabel}" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="2" Text="{Binding AdSegmentLabel}" VerticalAlignment="Center"/>
         <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding TranscriptStatus}"><SymbolIcon Symbol="Comment" Opacity="{Binding TranscriptOpacity}"/><TextBlock Text="✓" Foreground="#209447" Visibility="{Binding HasTranscript, Converter={StaticResource VisibleWhenTrue}}"/></StackPanel>
         <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding SummaryStatus}"><SymbolIcon Symbol="AlignLeft" Opacity="{Binding SummaryOpacity}"/><TextBlock Text="✓" Foreground="#209447" Visibility="{Binding HasSummary, Converter={StaticResource VisibleWhenTrue}}"/></StackPanel>
         <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding NarrationStatus}"><SymbolIcon Symbol="Volume" Opacity="{Binding NarrationOpacity}"/><TextBlock Text="✓" Foreground="#209447" Visibility="{Binding HasNarration, Converter={StaticResource VisibleWhenTrue}}"/></StackPanel>
         <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><SymbolIcon Symbol="Video" Opacity="{Binding ExportsOpacity}"/><TextBlock Text="{Binding VideoExportLabel}"/></StackPanel>
         <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"><SymbolIcon Symbol="Volume" Opacity="{Binding ExportsOpacity}"/><TextBlock Text="{Binding AudioExportLabel}"/></StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
    <StackPanel x:Name="GalleryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"><SymbolIcon Symbol="Video"/><TextBlock Text="Your projects live here" Style="{ThemeResource SubtitleTextBlockStyle}"/><TextBlock x:Name="GalleryEmptySubtitle" Text="Import a video or add a public YouTube link to begin." Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
   </Grid>
  </Grid>
  <ContentControl x:Name="EditorWorkspace" Grid.Row="4" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <SplitView x:Name="InspectorSplitView" DisplayMode="Inline" PanePlacement="Right" IsPaneOpen="True" OpenPaneLength="310" PaneBackground="{ThemeResource LayerFillColorAltBrush}">
    <SplitView.Pane>
    <Grid x:Name="InspectorPanel" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer><StackPanel Padding="18,22" Spacing="18">
      <StackPanel Spacing="8">
       <Grid>
        <TextBlock Text="Project Information" FontWeight="SemiBold"/>
        <Button x:Name="InspectorIntegrityButton" Click="OpenInspectorIntegrity_Click" Visibility="Collapsed" HorizontalAlignment="Right" Padding="4" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Show all project file issues" ToolTipService.ToolTip="Show all project file issues">
         <FontIcon x:Name="InspectorIntegrityIcon" Glyph="&#xE7BA;" FontSize="14"/>
        </Button>
       </Grid>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10"><StackPanel x:Name="ProjectDetails" Spacing="8"/></Border>
       <TextBlock x:Name="ProjectInformation" Visibility="Collapsed"/>
      </StackPanel>
      <StackPanel Spacing="8"><TextBlock Text="Video Information" FontWeight="SemiBold"/><Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10"><StackPanel x:Name="VideoDetails" Spacing="8"/></Border></StackPanel>
      <StackPanel x:Name="ContextActions" Spacing="8">
       <TextBlock x:Name="InspectorSectionTitle" Text="Transcript" FontWeight="SemiBold"/>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
        <StackPanel Spacing="6">
         <Button x:Name="InspectorGenerate" Content="Generate Transcript" Style="{StaticResource InspectorButton}" Click="GenerateCurrent_Click"/>
         <Button x:Name="InspectorRewriteButton" Style="{StaticResource InspectorButton}" Click="Rewrite_Click" Visibility="Collapsed"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8AC;" FontSize="14"/><TextBlock Text="Rewrite selected to fit"/></StackPanel></Button>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="NarrationActions" Spacing="8" Visibility="Collapsed">
       <TextBlock Text="Narration Audio" FontWeight="SemiBold"/>
       <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="10">
        <StackPanel Spacing="6">
         <StackPanel x:Name="InspectorNarrationProgressPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><ProgressRing x:Name="InspectorNarrationRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Center"/><FontIcon Glyph="&#xE767;" FontSize="14" VerticalAlignment="Center"/><TextBlock x:Name="InspectorNarrationStatusText" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
         <Button x:Name="InspectorSynthesizeNarrationButton" Style="{StaticResource InspectorButton}" Tag="synthesize-tts" Click="Command_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE767;" FontSize="14"/><TextBlock x:Name="InspectorSynthesizeNarrationLabel" Text="Generate All AD Audio"/></StackPanel></Button>
         <Button x:Name="InspectorSynthesizeChangedButton" Style="{StaticResource InspectorButton}" Click="ChangedNarration_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14"/><TextBlock Text="Generate Missing or Changed AD Audio"/></StackPanel></Button>
         <Button Style="{StaticResource InspectorButton}" Click="DeleteNarration_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74F;" FontSize="14"/><TextBlock Text="Delete selected narration"/></StackPanel></Button>
        </StackPanel>
       </Border>
      </StackPanel>
      <Button Style="{StaticResource InspectorButton}" Click="DeleteGenerated_Click"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE74D;" FontSize="14"/><TextBlock Text="Choose content to delete"/></StackPanel></Button>
      <StackPanel Spacing="8"><TextBlock Text="Video Analysis Availability" FontWeight="SemiBold"/><TextBlock x:Name="AnalysisAvailability" Text="Not checked" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PrepareAnalysisButton" Content="Prepare" Tag="prepare-analysis-video" Click="Command_Click"/><Button x:Name="RefreshAnalysisButton" Content="Refresh" Tag="check-video-availability" Click="Command_Click"/><Button x:Name="OcrFrameButton" Content="Read frame" Click="Ocr_Click"/></StackPanel></StackPanel>
      <StackPanel Spacing="8"><TextBlock Text="Export" FontWeight="SemiBold"/><Button x:Name="InspectorExportButton" Content="Export…" Style="{StaticResource InspectorButton}" Click="Export_Click"/><TextBlock Text="Created Exports" FontWeight="SemiBold"/><StackPanel x:Name="InspectorExports" Spacing="6"/></StackPanel>
     </StackPanel></ScrollViewer>
     <Grid Grid.Row="1" Padding="14,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="&#xE8B7;" FontFamily="Segoe Fluent Icons" Click="Reveal_Click" AutomationProperties.Name="Open project folder" ToolTipService.ToolTip="Open the project folder"/><Button x:Name="InspectorOpenConfigurationButton" Visibility="Collapsed" Grid.Column="1" Content="&#xE943;" FontFamily="Segoe Fluent Icons" Click="OpenConfiguration_Click" Margin="4,0,0,0" AutomationProperties.Name="Open project configuration" ToolTipService.ToolTip="Open project.json in the default editor"/><Button Grid.Column="3" x:Name="InspectorSettingsButton" Content="&#xE713;" FontFamily="Segoe Fluent Icons" Click="Settings_Click" HorizontalAlignment="Right" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings"/></Grid>
    </Grid>
    </SplitView.Pane>
    <SplitView.Content>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <SplitView x:Name="ProjectSplitView" DisplayMode="Inline" PanePlacement="Left" IsPaneOpen="False" OpenPaneLength="240" PaneBackground="{ThemeResource LayerFillColorAltBrush}" PaneClosing="ProjectPane_Closing">
       <SplitView.Pane>
    <Grid x:Name="LibraryPanel" Padding="12" RowSpacing="10" Background="{ThemeResource LayerFillColorAltBrush}">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" PlaceholderText="Search projects" TextChanged="Search_Changed" AutomationProperties.Name="Search projects"/>
     <ComboBox x:Name="SourceFilter" Grid.Row="1" SelectedIndex="0" SelectionChanged="Filter_Changed" HorizontalAlignment="Stretch" AutomationProperties.Name="Project source filter"><ComboBoxItem Content="All projects"/><ComboBoxItem Content="Local videos"/><ComboBoxItem Content="YouTube videos"/></ComboBox>
     <Grid Grid.Row="2"><GridView x:Name="ProjectGrid" Visibility="Collapsed" ItemsSource="{x:Bind Model.Projects}" ItemTemplate="{StaticResource EditorProjectCard}" AutomationProperties.Name="Projects grid" SelectionChanged="ProjectGrid_Changed" ContextRequested="ProjectContext_Requested"/><ListView x:Name="ProjectList" ItemsSource="{x:Bind Model.Projects}" SelectionChanged="Project_Changed" ContextRequested="ProjectContext_Requested" AutomationProperties.Name="Projects"/></Grid>
     <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"><Button Content="Rename" Click="Rename_Click"/><Button x:Name="EditorRemoveProjectButton" Content="&#xE738;" FontFamily="Segoe Fluent Icons" Click="RemoveListedProject_Click" ToolTipService.ToolTip="Remove the selected project from the list and keep its files" AutomationProperties.Name="Remove selected project from list"/><Button x:Name="EditorDeleteProjectButton" Content="&#xE74D;" FontFamily="Segoe Fluent Icons" Click="DeleteListedProject_Click" ToolTipService.ToolTip="Move the selected project and its files to the Recycle Bin after confirmation" AutomationProperties.Name="Delete selected project"/></StackPanel>
    </Grid>
       </SplitView.Pane>
       <SplitView.Content>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid x:Name="PreviewPanel" Height="150" Background="Black"><MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"/><WebView2 x:Name="YouTubePlayer" Visibility="Collapsed"/><StackPanel x:Name="CaptionOverlay" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,16,16,48" Spacing="4" IsHitTestVisible="False"><Border x:Name="DialogueCaptionBox" Padding="12,6" CornerRadius="4"><TextBlock x:Name="CaptionText" TextWrapping="Wrap" TextAlignment="Center"/></Border><Border x:Name="DescriptionCaptionBox" Padding="12,6" CornerRadius="4"><TextBlock x:Name="DescriptionCaptionText" TextWrapping="Wrap" TextAlignment="Center"/></Border></StackPanel></Grid>
     <StackPanel Grid.Row="1" x:Name="TimelinePanel" Spacing="4" Padding="18,8">
      <Grid><TextBlock Text="Timeline" FontWeight="SemiBold"/><TextBlock x:Name="TimeLabel" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Grid>
      <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Thumbnails" VerticalAlignment="Center"/>
